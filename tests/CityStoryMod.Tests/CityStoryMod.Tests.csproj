<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure-C# tests. Does NOT import Mod.props/Mod.targets and does NOT reference
    Game.dll, Colossal.*, or Unity.* — that's the whole point. Tests can only
    exercise the testable subset of the mod (see CLAUDE.md → Testing).

    Code under test is brought in via <Compile Link> rather than ProjectReference
    so we don't pull the mod project's CS2-specific imports into this build.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>CityStoryMod.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\TextUtils.cs" Link="LinkedSources\TextUtils.cs" />
    <Compile Include="..\..\PathUtils.cs" Link="LinkedSources\PathUtils.cs" />
    <Compile Include="..\..\TemplateScaffolder.cs" Link="LinkedSources\TemplateScaffolder.cs" />
    <Compile Include="..\..\Storyteller\CartoProcessor.cs" Link="LinkedSources\CartoProcessor.cs" />
    <Compile Include="..\..\Storyteller\PngWriter.cs" Link="LinkedSources\PngWriter.cs" />
    <Compile Include="..\..\Storyteller\Raster.cs" Link="LinkedSources\Raster.cs" />
    <Compile Include="..\..\Storyteller\GeoTiffReader.cs" Link="LinkedSources\GeoTiffReader.cs" />
    <Compile Include="..\..\Storyteller\MapCoords.cs" Link="LinkedSources\MapCoords.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

</Project>
